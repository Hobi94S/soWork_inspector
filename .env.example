# Identificador do escritório (segmento depois de /s/ na URL).
SOWORK_GROUP_ID=
SOWORK_APP_URL=https://app.sowork.com/
SOWORK_TIME_ZONE=America/Sao_Paulo
SOWORK_POLL_SECONDS=60
SOWORK_HEADLESS=true
SOWORK_PROFILE_DIR=profiles/sowork
SOWORK_OUTPUT_DIR=runtime
SOWORK_LOGIN_TIMEOUT=300
# Opcional: endpoint HTTP POST para eventos entry/exit. Vazio desativa envio.
SOWORK_WEBHOOK_URL=
# Opcional: caminhos locais, caso Selenium Manager não possa baixar o driver.
SOWORK_CHROME_BINARY=
SOWORK_CHROMEDRIVER=
